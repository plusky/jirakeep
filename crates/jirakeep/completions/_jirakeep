#compdef jirakeep

autoload -U is-at-least

_jirakeep() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'--jira-server=[Base URL of the Jira Cloud site (e.g. '\''https\://example.atlassian.net'\'')]:JIRA_SERVER:_default' \
'--transport=[Transport for the MCP server\: '\''http'\'' (default) or '\''stdio'\'']:TRANSPORT:((http\:"Streamable HTTP transport (default)"
stdio\:"Stdio transport"))' \
'--host=[Host address for the MCP server to listen on (http transport only)]:HOST:_default' \
'--port=[Port for the MCP server to listen on (http transport only)]:PORT:_default' \
'--api-key-header=[HTTP header for clients to send the Jira API token]:API_KEY_HEADER:_default' \
'--email-header=[HTTP header for clients to send the Atlassian account email (per-request Cloud Basic auth when --email is not set on the server)]:EMAIL_HEADER:_default' \
'--api-key=[Jira Cloud API token]:API_KEY:_default' \
'--api-key-file=[Path to a file holding the Jira Cloud API token]:API_KEY_FILE:_files' \
'--email=[Atlassian account email for Cloud Basic auth]:EMAIL:_default' \
'--email-file=[Path to a file holding the Atlassian account email]:EMAIL_FILE:_files' \
'--policy=[Path to the guard policy TOML file]:POLICY:_files' \
'--audit-config=[Path to the audit configuration TOML file]:AUDIT_CONFIG:_files' \
'--read-only[Disables all tools which modify Jira state]' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
'-V[Print version]' \
'--version[Print version]' \
&& ret=0
}

(( $+functions[_jirakeep_commands] )) ||
_jirakeep_commands() {
    local commands; commands=()
    _describe -t commands 'jirakeep commands' commands "$@"
}

if [ "$funcstack[1]" = "_jirakeep" ]; then
    _jirakeep "$@"
else
    compdef _jirakeep jirakeep
fi
